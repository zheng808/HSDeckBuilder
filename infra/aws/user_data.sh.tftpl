#!/bin/bash
# First-boot bootstrap (cloud-init user data). Logs to /var/log/hsdeck-bootstrap.log.
set -euxo pipefail
exec > >(tee -a /var/log/hsdeck-bootstrap.log | logger -t hsdeck) 2>&1

dnf install -y docker
systemctl enable --now docker

# --- data volume: find it by EBS volume id, format on first use, mount at /data
DEV=""
for i in $(seq 1 150); do
  DEV=$(ls /dev/disk/by-id/ 2>/dev/null | grep -i "${volume_id_nodash}" | grep -v -- "-part" | head -1 || true)
  if [ -n "$DEV" ]; then break; fi
  sleep 2
done
if [ -z "$DEV" ]; then echo "data volume ${volume_id_nodash} never appeared"; exit 1; fi
DEV="/dev/disk/by-id/$DEV"
if ! blkid "$DEV" >/dev/null 2>&1; then
  mkfs.ext4 -L hsdeck-data "$DEV"
fi
mkdir -p /data
if ! grep -q "LABEL=hsdeck-data" /etc/fstab; then
  echo "LABEL=hsdeck-data /data ext4 defaults,nofail 0 2" >> /etc/fstab
fi
mount -a
mkdir -p /data/app /data/caddy
chown -R 1000:1000 /data/app   # the image runs as uid 1000 (node)

# --- deploy script: idempotent, also used by the GitHub deploy workflow via SSM
mkdir -p /opt/hsdeck
cat > /opt/hsdeck/deploy.sh <<'DEPLOY'
#!/bin/bash
set -euo pipefail
IMAGE="${image}"
APP_HOST="${app_host}"

docker network inspect hsdeck >/dev/null 2>&1 || docker network create hsdeck

docker pull "$IMAGE"
docker rm -f hsdeck >/dev/null 2>&1 || true
docker run -d --name hsdeck --restart unless-stopped --network hsdeck \
  -v /data/app:/data "$IMAGE"

for i in $(seq 1 30); do
  if docker exec hsdeck wget -qO- http://127.0.0.1:3001/api/health >/dev/null 2>&1; then break; fi
  sleep 2
done
docker exec hsdeck npm run import:pro-decks || true

if ! docker ps --format '{{.Names}}' | grep -qx caddy; then
  docker run -d --name caddy --restart unless-stopped --network hsdeck \
    -p 80:80 -p 443:443 -v /data/caddy:/data caddy:2 \
    caddy reverse-proxy --from "https://$APP_HOST" --to hsdeck:3001
fi

docker image prune -f >/dev/null 2>&1 || true
echo "deployed $IMAGE at https://$APP_HOST"
DEPLOY
chmod +x /opt/hsdeck/deploy.sh

/opt/hsdeck/deploy.sh
