#!/bin/bash
# First-boot bootstrap (cloud-init user data). Logs to /var/log/hsdeck-bootstrap.log.
set -euxo pipefail
exec > >(tee -a /var/log/hsdeck-bootstrap.log | logger -t hsdeck) 2>&1

dnf install -y docker
systemctl enable --now docker

# --- data volume: find it by EBS volume id, format on first use, mount at /data
DEV=""
for i in $(seq 1 150); do
  DEV=$(ls /dev/disk/by-id/ 2>/dev/null | grep -i "${volume_id_nodash}" | grep -v -- "-part" | head -1 || true)
  if [ -n "$DEV" ]; then break; fi
  sleep 2
done
if [ -z "$DEV" ]; then echo "data volume ${volume_id_nodash} never appeared"; exit 1; fi
DEV="/dev/disk/by-id/$DEV"
if ! blkid "$DEV" >/dev/null 2>&1; then
  mkfs.ext4 -L hsdeck-data "$DEV"
fi
mkdir -p /data
if ! grep -q "LABEL=hsdeck-data" /etc/fstab; then
  echo "LABEL=hsdeck-data /data ext4 defaults,nofail 0 2" >> /etc/fstab
fi
mount -a
mkdir -p /data/app /data/caddy
chown -R 1000:1000 /data/app   # the image runs as uid 1000 (node)

# --- deploy script: versioned in the repo; fetched here and by the GitHub deploy workflow
mkdir -p /opt/hsdeck
echo "${app_host}" > /opt/hsdeck/app_host
curl -fsSL "${deploy_script_url}" -o /opt/hsdeck/deploy.sh
chmod +x /opt/hsdeck/deploy.sh
IMAGE="${image}" /opt/hsdeck/deploy.sh
