PORT=3001
# SQLite file path (relative to server/). Use ":memory:" for an ephemeral DB.
DB_PATH=./decks.db
# Comma-separated origins allowed by CORS in production (dev allows the Vite origin).
CORS_ORIGINS=http://localhost:5173

# --- accounts (optional; sign-in is hidden when no provider is configured)
# Public origin for OAuth callbacks (callback URLs are <APP_URL>/api/auth/callback/<provider>)
APP_URL=http://localhost:5173
AUTH_SECRET=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Users who become admins on sign-in: provider:login
ADMIN_LOGINS=github:zheng808
# --- pro-list collector
YOUTUBE_API_KEY=
# Token for the scheduled POST /api/admin/collect
ADMIN_API_TOKEN=
